 static char *hostbased_cuser = NULL;
 static char *hostbased_chost = NULL;
 static char *auth_method = "unknown";
+#ifdef USE_PAM
+/*
+ * Record only authentication decisions made by the privileged monitor.
+ * This excludes offered-but-unverified public keys and sensitive key data.
+ * Each SSH connection has an isolated monitor process.
+ */
+static char saspam_verified_auth[512];
+static size_t saspam_verified_len;
+
+static void
+saspam_record_verified_auth(void)
+{
+	char item[160];
+	const char *algorithm = NULL;
+	int n;
+
+	if (strcmp(auth_method, "publickey") == 0) {
+		if (authctxt->auth_method_key != NULL)
+			algorithm = sshkey_ssh_name(authctxt->auth_method_key);
+		if (algorithm != NULL)
+			n = snprintf(item, sizeof(item), "publickey %s", algorithm);
+		else
+			n = snprintf(item, sizeof(item), "publickey");
+	} else if (strcmp(auth_method, "password") == 0 ||
+	    strcmp(auth_method, "keyboard-interactive") == 0 ||
+	    strcmp(auth_method, "hostbased") == 0) {
+		n = snprintf(item, sizeof(item), "%s", auth_method);
+	} else {
+		n = snprintf(item, sizeof(item), "unknown");
+	}
+	if (n < 0 || (size_t)n >= sizeof(item) ||
+	    saspam_verified_len + (size_t)n + 2 > sizeof(saspam_verified_auth))
+		fatal_f("verified authentication method list too long");
+
+	memcpy(saspam_verified_auth + saspam_verified_len, item, (size_t)n);
+	saspam_verified_len += (size_t)n;
+	saspam_verified_auth[saspam_verified_len++] = '\n';
+	saspam_verified_auth[saspam_verified_len] = '\0';
+}
+#endif
 static char *auth_submethod = NULL;
 static u_int session_id2_len = 0;
 static u_char *session_id2 = NULL;
